# Copy to .env and adjust. .env is git-ignored.
# Core
APP_ENV=development
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# Database
# Host port 5433 avoids a local PostgreSQL already listening on 5432.
DATABASE_URL=postgresql+asyncpg://rag_app:rag_app@localhost:5433/rag
DATABASE_MIGRATION_URL=postgresql+asyncpg://rag_owner:rag_owner@localhost:5433/rag
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_STATEMENT_TIMEOUT_MS=15000

# Redis
# Host port 6380 avoids a local Redis already listening on 6379.
REDIS_URL=redis://localhost:6380/0
INGEST_STREAM=rag:ingest
INGEST_GROUP=ingest-workers
INGEST_DEAD_STREAM=rag:ingest:dead
INGEST_CLAIM_IDLE_MS=300000
INGEST_SWEEPER_INTERVAL_SECONDS=60
WORKER_JOB_TIMEOUT_SECONDS=900
WORKER_CONCURRENCY=2

# Object storage
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=rag-documents
S3_REGION=us-east-1
MAX_UPLOAD_BYTES=52428800

# Auth
JWT_SECRET=dev-only-change-me-at-least-32-bytes
JWT_ISSUER=winnow
JWT_AUDIENCE=rag-api
ACCESS_TOKEN_TTL_SECONDS=1800
REFRESH_TOKEN_TTL_SECONDS=604800
ALLOW_TENANT_SIGNUP=true
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=2

# Embeddings
# Keep fake for Phases 0-3. Before Phase 4 set EMBEDDING_PROVIDER=gemini and
# GEMINI_API_KEY=... .
GEMINI_API_KEY=
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=1536
EMBEDDING_DOCUMENT_TASK=RETRIEVAL_DOCUMENT
EMBEDDING_QUERY_TASK=RETRIEVAL_QUERY
EMBEDDING_BATCH_SIZE=16
EMBEDDING_CONCURRENCY=2
EMBEDDING_REQUESTS_PER_MINUTE=60
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=5
EMBEDDING_QUERY_CACHE_TTL_SECONDS=3600

# Chunking
CHUNK_TARGET_CHARS=3000
CHUNK_OVERLAP_CHARS=400
CHUNK_MAX_CHARS=6000
CHUNK_MIN_CHARS=200
PDF_MAX_PAGES=1000

# Search
SEARCH_CANDIDATES=50
SEARCH_TOP_K_DEFAULT=10
SEARCH_TOP_K_MAX=50
RRF_K=60
DENSE_WEIGHT=1.0
SPARSE_WEIGHT=1.0
HNSW_EF_SEARCH=100
HNSW_ITERATIVE_SCAN=strict_order
HNSW_MAX_SCAN_TUPLES=20000

# Rate limits (per window; window is 60 seconds unless stated)
RL_LOGIN_PER_MINUTE=10
RL_REGISTER_PER_HOUR=5
RL_UPLOAD_PER_HOUR=30
RL_SEARCH_PER_MINUTE=120

# Maintenance
# Days a soft-deleted document (and its stored object) is kept before
# scripts/purge.py hard-deletes it.
SOFT_DELETE_RETENTION_DAYS=30
